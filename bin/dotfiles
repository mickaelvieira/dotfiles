#!/bin/bash
# shellcheck disable=SC2048

set -e -u -o pipefail
# set -x

declare -r SCRIPT=$(basename "$0")
declare -r HOME_DIR=${HOME:-}
declare -r ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
declare -r PLATFORM=$(uname)

source "$(dirname "${BASH_SOURCE[0]}")/../lib/logging.sh"

dotfiles::install::read_help() {
  cat <<eom
This script helps me move into a new environment.

$(dotfiles::log::highlight Usage):
  ${SCRIPT} [command]

$(dotfiles::log::highlight Commands):
- install:    install configuration files
- check:      list of available services
- help:       show this help

$(dotfiles::log::highlight Examples):
  ${SCRIPT} install               (install configuration files)
  ${SCRIPT} check                 (check dependencies)
eom
}

dotfiles::install::usage() {
  echo -e "\\n$(dotfiles::install::read_help)\\n" 1>&2
  exit 0
}

dotfiles::install::is_command_installed() {
  command -v "$1" >/dev/null 2>&1
}

dotfiles::install::get_install_command() {
  local cmd=""

  if dotfiles::install::is_command_installed apt; then
    cmd="apt install"
  elif dotfiles::install::is_command_installed pacman; then
    cmd="pacman -S"
  elif dotfiles::install::is_command_installed apt-get; then
    cmd="apt-get install"
  elif dotfiles::install::is_command_installed brew; then
    cmd="brew install"
  fi

  echo "$cmd"
}

dotfiles::install::create_symlink() {
  local target="$1"
  local symlink="$2"
  local backup="${symlink}.orig"

  if [[ (-f $symlink && ! -L $symlink) || -d $symlink ]]; then
    dotfiles::log::info "moving existing location $symlink to $backup"
    mv "$symlink" "$backup"
  fi

  if [[ ! -f $target && ! -d $target ]]; then
    dotfiles::log::fatal "target $target is neither a file nor a directory"
  fi

  dotfiles::log::info "creating symlink $symlink"
  ln -svf "$target" "$symlink"
}

dotfiles::install::ask_confirm() {
  local answer=
  local name="$1"

  read -epr "$(echo -e "Do you want to install $(dotfiles::log::highlight "$name") configuration? [Y/n]:") " answer

  [[ -z $answer ]] && answer="y"

  echo "$answer"
}

dotfiles::install::bash() {
  local files=(
    .bashrc
    .bash_prompt
    .bash_options
    .bash_export
    .bash_profile
    .bash_aliases
    .bash_functions
    .bash_logout
    .dircolors
    .profile
  )

  for file in ${files[*]}; do
    dotfiles::install::create_symlink "$ROOT_DIR/bash/$file" "$HOME_DIR/$file"
  done

  source "$HOME_DIR/.bashrc"
}

dotfiles::install::git() {
  local files=(
    .gitconfig
    .gitignore
    .gitmessage
    .gitattributes
  )

  for file in ${files[*]}; do
    dotfiles::install::create_symlink "$ROOT_DIR/git/$file" "$HOME_DIR/$file"
  done
}

dotfiles::install::vim() {
  dotfiles::install::create_symlink "$ROOT_DIR/vim/.vim" "$HOME_DIR/.vim"
  dotfiles::install::create_symlink "$ROOT_DIR/vim/.vimrc" "$HOME_DIR/.vimrc"

  dotfiles::log::info "Fetching plug.vim"
  curl -s https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim \
    -o "$HOME_DIR/.vim/autoload/plug.vim"

  dotfiles::log::warn "Don't forget to run PlugInstall!"
}

dotfiles::install::tmux() {
  dotfiles::install::create_symlink "$ROOT_DIR/tmux/.tmux.conf" "$HOME_DIR/.tmux.conf"
}

dotfiles::install::all_with_confirmation() {
  [[ $(dotfiles::install::ask_confirm "bash") == y ]] && dotfiles::install::bash
  [[ $(dotfiles::install::ask_confirm "git") == y ]] && dotfiles::install::git
  [[ $(dotfiles::install::ask_confirm "vim") == y ]] && dotfiles::install::vim
  [[ $(dotfiles::install::ask_confirm "tmux") == y ]] && dotfiles::install::tmux
}

dotfiles::install::get_choices() {
  cat <<eom
Which configuration do you want to install? (All):
1) All
2) Bash
3) Vim
4) Git
5) Tmux
>
eom
}

dotfiles::install::main() {
  [[ -z $HOME_DIR ]] && dotfiles::log::fatal "HOME directory cannot be an empty string"
  [[ $PLATFORM != Linux && $PLATFORM != Darwin ]] && dotfiles::log::fatal "platform '$PLATFORM' is not supported"

  local command=${1:-}

  case $command in
  install)
    local choice=
    read -r -ep "$(dotfiles::install::get_choices) " choice

    [[ -z $choice ]] && choice=1

    case $choice in
    1) dotfiles::install::all_with_confirmation ;;
    2) dotfiles::install::bash ;;
    3) dotfiles::install::vim ;;
    4) dotfiles::install::git ;;
    5) dotfiles::install::tmux ;;
    *) dotfiles::log::fatal "Incorrect configuration number" ;;
    esac
    ;;
  check)
    local cmd="$(dotfiles::install::get_install_command)"

    [[ -z $cmd ]] && dotfiles::log::fatal "cannot get install command"

    local libraries=(
      git
      vim
      tmux
      tree
      jq
      yq
      rsync
      curl
      source-highlight
      bat
      fzf
    )

    for lib in ${libraries[*]}; do
      if ! dotfiles::install::is_command_installed "$lib"; then
        sudo sh -c "$cmd $lib"
      else
        dotfiles::log::info "$(dotfiles::log::highlight "$lib") is already installed"
      fi
    done

    dotfiles::log::warn "make also sure that bash-completion is installed"
    ;;
  *)
    dotfiles::install::usage
    ;;
  esac
}

dotfiles::install::main "$@"
